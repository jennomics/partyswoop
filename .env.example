# PartySwoop Environment Variables
#
# Database: Cloudflare D1 (configured in wrangler.toml, no connection string needed)
#
# OpenAI API key for the fridge scan feature (optional - app works without it)
OPENAI_API_KEY=your-key-here

# Public base URL for QR code generation
NEXT_PUBLIC_BASE_URL=http://localhost:3000
